{
  "name": "UltimatePitch",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "Lighting": { "$properties": { "LightingStyle": "Realistic", "PrioritizeLightingQuality": false } },
    "ServerScriptService": {
      "UltimatePitchServer": {
        "$path": "src/Server.server.lua",
        "Dome": { "$path": "src/Dome.lua" },
