        "Career": { "$path": "src/Career.lua" }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "UltimatePitchClient": {
          "$path": "src/Client.client.lua",
          "AuroraFX": { "$path": "src/AuroraFX.lua" },
          "Matchday": { "$path": "src/Matchday.lua" },
          "CareerUI": { "$path": "src/CareerUI.lua" }
        }
      }
    }
  }
}
